# ==========================================
# Sanity CMS Configuration
# ==========================================
# Your Sanity project ID (find in sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Target dataset (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Version
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Secret token used to verify webhooks from Sanity on additions/deletions
SANITY_REVALIDATE_SECRET=your_custom_webhook_secret_here
